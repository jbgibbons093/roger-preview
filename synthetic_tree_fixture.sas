  logic_json='{"id":"g0","op":"AND","children":[{"id":"g1","op":"OR","children":[0,1]},2]}';
  created_at=datetime();
  format created_at datetime20. index_start index_end yymmdd10.;
  index_start=&index_start;
  index_end=&index_end;
  input_path='';
  output_path='';
  age_min=18;
  age_max=64;
  sex='ALL';
  enrollment=0;
  baseline=90;
  followup=0;
  gap=0;
  rx=0;
  extract_before=90;
  extract_after=0;
  outputs='';
  outlib='WORK';
  length map_O $41; map_O='WORK.TREE_FIXTURE_O';
  length map_S $41; map_S='';
  length map_I $41; map_I='';
  length map_F $41; map_F='';
  length map_D $41; map_D='';
  length map_T $41; map_T='';
run;
data work._rg_rules;
  length rule_id min_days lower_day upper_day 8 mode $7 domain $5 sources $12;
  infile datalines4 dlm='|' dsd truncover;
  input rule_id mode :$7. domain :$5. sources :$12. min_days lower_day upper_day;
datalines4;
