/* SYNTHETIC DATA ONLY. Run in a fresh SAS session separately from the core fixture.
   Expected IDs 1 2 3. OR branches include people who pass either event criterion.
   Exclusion applies to both branches. Last-index demographics exclude person 6. */
data work.tree_fixture_O;
  length ENROLID YEAR AGE SEQNUM SVCDATE 8 SEX DXVER PROCTYP $1 DX1-DX4 PROC1 $7;
  YEAR=2023;SEX='1';SEQNUM=0;
  do ENROLID=1 to 6;
    AGE=40;DXVER='0';PROCTYP='1';PROC1='';DX1='E119';SVCDATE='15JUN2023'd;SEQNUM+1;output;
    if ENROLID in (1,6) then do;
      SVCDATE='18JUN2023'd;if ENROLID=6 then AGE=17;SEQNUM+1;output;
    end;
    DX1='';AGE=40;SVCDATE='10JUN2023'd;
    if ENROLID in (1,3,6) then do;PROC1='99213';PROCTYP='1';SEQNUM+1;output;end;
    if ENROLID in (2,3,4,5) then do;
      PROC1='J0001';PROCTYP='7';if ENROLID=4 then PROCTYP='1';SEQNUM+1;output;
    end;
    if ENROLID in (3,5) then do;
      PROC1='';DX1='Z850';DXVER='0';if ENROLID=3 then DXVER='9';SEQNUM+1;output;
    end;
  end;
run;
/* Generated by ROGER. MarketScan 2023. SAS 9.4.
   Run in your approved SAS environment. Review the definition and mappings.
   Last matching event in the index window is selected BEFORE later filters.
   Ties use source table letter then SEQNUM. One row per ENROLID.
   Distinct service days determine repeated-event criteria.
   This program has not been executed by the browser.
   Mappings supplied. Verify they identify the intended database and edition.
*/
options errorabend;
